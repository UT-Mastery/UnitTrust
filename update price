name: Update prices
on:
  schedule:
    - cron: "30 2 * * 1-6"
    - cron: "30 9 * * 1-6"
  workflow_dispatch:
permissions:
  contents: write
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install pypdf
      - run: python fetch_prices.py
      - run: |
          git config user.name "price-bot"
          git config user.email "bot@users.noreply.github.com"
          git add prices.json history.json
          git diff --cached --quiet || (git commit -m "Update prices" && git push)
